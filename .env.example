# Copy to backend/.env for local (non-Docker) runs, or to .env for docker compose.
# Every variable is optional; defaults give the lite profile.

# --- Lite profile defaults (no services needed) ---------------------------------
# EVALFORGE_DATA_DIR=./var                  # datasets, SQLite DBs, MLflow artifacts
# EVALFORGE_EXECUTOR=thread                 # thread | rq | sync
# EVALFORGE_MAX_CONCURRENT_JOBS=1           # keep at 1-2 on an 8 GB machine

# --- Full profile ---------------------------------------------------------------
# EVALFORGE_DATABASE_URL=postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge
# EVALFORGE_MLFLOW_TRACKING_URI=http://localhost:5000
# EVALFORGE_EXECUTOR=rq
# EVALFORGE_REDIS_URL=redis://localhost:6379/0
# POSTGRES_PASSWORD=change-me

# --- Upload guard rails ---------------------------------------------------------
# EVALFORGE_MAX_UPLOAD_MB=50
# EVALFORGE_MAX_ROWS=2000000
# EVALFORGE_MAX_COLUMNS=500

# --- Frontend -------------------------------------------------------------------
# EVALFORGE_API_URL=http://127.0.0.1:8000   # where the Next.js server proxies /api

# --- Later phases (not used yet) ------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
