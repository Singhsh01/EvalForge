# Copy to backend/.env (lite profile) or ./.env (docker compose). Everything is optional;
# defaults give the lite profile. Never commit real secrets.

# --- Accounts ------------------------------------------------------------------------
# First start creates admin / engineer / approver / viewer with this password.
# Required when EVALFORGE_ENV=prod; dev/test default: evalforge-dev
# EVALFORGE_BOOTSTRAP_PASSWORD=change-me-please
# EVALFORGE_TOKEN_TTL_HOURS=12
# EVALFORGE_ALLOW_SELF_APPROVAL=false   # keep false: approvals need a second person

# --- Lite profile (no services) --------------------------------------------------------
# EVALFORGE_DATA_DIR=./var
# EVALFORGE_EXECUTOR=thread            # thread | rq | sync
# EVALFORGE_MAX_CONCURRENT_JOBS=1

# --- Full profile ------------------------------------------------------------------------
# EVALFORGE_DATABASE_URL=postgresql+psycopg://evalforge:evalforge@localhost:5432/evalforge
# EVALFORGE_MLFLOW_TRACKING_URI=http://localhost:5000
# EVALFORGE_EXECUTOR=rq
# EVALFORGE_REDIS_URL=redis://localhost:6379/0
# POSTGRES_PASSWORD=change-me

# --- Governance thresholds -----------------------------------------------------------------
# EVALFORGE_GATE_MIN_F1=0.80
# EVALFORGE_GATE_MAX_F1_REGRESSION=0.01
# EVALFORGE_GATE_MAX_P95_LATENCY_MS=250

# --- LLM providers (optional; nothing is called unless configured) -------------------------
# EVALFORGE_ANTHROPIC_API_KEY=
# EVALFORGE_OPENAI_BASE_URL=http://localhost:11434/v1   # e.g. Ollama, vLLM, LM Studio
# EVALFORGE_OPENAI_API_KEY=
# EVALFORGE_LLM_PRICING={"claude-model-name": [input_usd_per_mtok, output_usd_per_mtok]}
# EVALFORGE_COPILOT_MAX_STEPS=12
# EVALFORGE_COPILOT_TIMEOUT_SECONDS=60

# --- Observability ---------------------------------------------------------------------------
# EVALFORGE_TRACING_ENABLED=true
# EVALFORGE_OTLP_ENDPOINT=http://otel-collector:4318     # with --profile observability

# --- Limits ----------------------------------------------------------------------------------
# EVALFORGE_MAX_UPLOAD_MB=50
# EVALFORGE_RATE_LIMIT_LOGIN_PER_MIN=10
# EVALFORGE_RATE_LIMIT_WRITE_PER_MIN=240
# EVALFORGE_RATE_LIMIT_SERVE_PER_MIN=1200

# --- Frontend --------------------------------------------------------------------------------
# EVALFORGE_API_URL=http://127.0.0.1:8000
